{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evalwitness.dev/protocol/1.2/schemas/evaluator-descriptor.schema.json",
  "title": "EvalWitness EvaluatorDescriptor",
  "type": "object",
  "required": ["schema_version", "protocol_name", "protocol_versions", "evaluator_id", "implementation", "execution_modes", "conformance_levels", "score_evidence_versions", "decision_evidence_versions", "limits", "live_capable", "extensions"],
  "properties": {
    "schema_version": {"const": "evalwitness.protocol.evaluator-descriptor.v1"},
    "protocol_name": {"const": "EvalWitness Verifier Audit Protocol"},
    "protocol_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}},
    "evaluator_id": {"$ref": "shared.schema.json#/$defs/identifier"},
    "implementation": {"type": "object", "required": ["name", "version", "identity_digest"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "identity_digest": {"$ref": "shared.schema.json#/$defs/digest"}}, "additionalProperties": false},
    "execution_modes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "conformance_levels": {"$ref": "shared.schema.json#/$defs/conformanceLevels"},
    "score_evidence_versions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "decision_evidence_versions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "limits": {"$ref": "shared.schema.json#/$defs/resourceLimits"},
    "live_capable": {"type": "boolean"},
    "extensions": {"$ref": "shared.schema.json#/$defs/extensions"}
  },
  "additionalProperties": false
}
