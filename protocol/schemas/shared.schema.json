{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evalwitness.dev/protocol/1.2/schemas/shared.schema.json",
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$", "maxLength": 128},
    "conformanceLevel": {"enum": ["syntax", "deterministic_replay", "live_score_evidence", "empirical_reliability", "independent_reproduction"]},
    "conformanceLevels": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/conformanceLevel"}},
    "caseKind": {"enum": ["canonical_encoding", "request_fingerprint", "score_evidence", "decision_evidence", "replay_evidence", "attestation", "extension", "compatibility"]},
    "resourceLimits": {"type": "object", "required": ["max_message_bytes", "max_case_bytes", "max_cases_per_run", "max_duration_millis", "max_extensions_per_item"], "properties": {"max_message_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608}, "max_case_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304}, "max_cases_per_run": {"type": "integer", "minimum": 1, "maximum": 10000}, "max_duration_millis": {"type": "integer", "minimum": 1, "maximum": 60000}, "max_extensions_per_item": {"type": "integer", "minimum": 1, "maximum": 32}}, "additionalProperties": false},
    "extension": {"type": "object", "required": ["namespace", "schema", "required", "payload"], "properties": {"namespace": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$"}, "schema": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}, "payload": {}}, "additionalProperties": false},
    "extensions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/extension"}},
    "trajectoryRef": {"type": "object", "required": ["canonical_schema", "source_format", "source_digest", "trajectory_digest", "accounting_digest", "trace_envelope_digest", "mapping_report_digest", "mapping_policy_version"], "properties": {"canonical_schema": {"type": "string", "minLength": 1}, "source_format": {"type": "string", "minLength": 1}, "source_digest": {"$ref": "#/$defs/digest"}, "trajectory_digest": {"$ref": "#/$defs/digest"}, "accounting_digest": {"$ref": "#/$defs/digest"}, "trace_envelope_digest": {"$ref": "#/$defs/digest"}, "mapping_report_digest": {"$ref": "#/$defs/digest"}, "mapping_policy_version": {"type": "string", "minLength": 1}, "inline": {}}, "additionalProperties": false},
    "canonicalJSONInput": {"type": "object", "required": ["source_utf8_hex", "expected_canonical_utf8_hex", "expected_sha256"], "properties": {"source_utf8_hex": {"type": "string", "pattern": "^([0-9a-f]{2})+$"}, "expected_canonical_utf8_hex": {"type": "string", "pattern": "^([0-9a-f]{2})+$"}, "expected_sha256": {"$ref": "#/$defs/digest"}}, "additionalProperties": false},
    "requestVector": {"type": "object", "required": ["vector_id", "canonical_utf8_hex", "expected_sha256"], "properties": {"vector_id": {"$ref": "#/$defs/identifier"}, "canonical_utf8_hex": {"type": "string", "pattern": "^([0-9a-f]{2})+$"}, "expected_sha256": {"$ref": "#/$defs/digest"}}, "additionalProperties": false},
    "scoreSupport": {"type": "object", "required": ["letter", "value_decimal", "probability_decimal", "source_ranks", "source_forms"], "properties": {"letter": {"type": "string", "minLength": 1, "maxLength": 1}, "value_decimal": {"$ref": "#/$defs/decimal"}, "probability_decimal": {"$ref": "#/$defs/decimal"}, "source_ranks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}, "source_forms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}, "additionalProperties": false},
    "visibleAlternative": {"type": "object", "required": ["rank", "token", "logprob_decimal", "probability_decimal", "chosen"], "properties": {"rank": {"type": "integer", "minimum": 1}, "token": {"type": "string"}, "logprob_decimal": {"$ref": "#/$defs/decimal"}, "probability_decimal": {"$ref": "#/$defs/decimal"}, "chosen": {"type": "boolean"}, "canonical_letter": {"type": "string"}, "canonical_value_decimal": {"$ref": "#/$defs/decimal"}, "diagnostic": {"type": "string"}, "canonical_source_ranks": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}}, "additionalProperties": false},
    "replayEvidence": {"type": "object", "required": ["request_fingerprint", "response_digest", "evidence_digest", "replay_status"], "properties": {"request_fingerprint": {"$ref": "#/$defs/digest"}, "response_digest": {"$ref": "#/$defs/digest"}, "evidence_digest": {"$ref": "#/$defs/digest"}, "replay_status": {"type": "string"}, "replay_reason": {"type": "string"}}, "additionalProperties": false},
    "attestationEvidence": {"type": "object", "required": ["schema_version", "attestation_digest", "state", "evidence_ceiling", "observed_at", "expires_at", "request_fingerprint", "route_limitations"], "properties": {"schema_version": {"type": "string"}, "attestation_digest": {"$ref": "#/$defs/digest"}, "state": {"type": "string"}, "evidence_ceiling": {"type": "string"}, "observed_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "request_fingerprint": {"$ref": "#/$defs/digest"}, "route_limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}, "additionalProperties": false},
    "caseResult": {"type": "object", "required": ["case_id", "conformance_level", "kind", "outcome", "reason", "finding_codes"], "properties": {"case_id": {"$ref": "#/$defs/identifier"}, "conformance_level": {"$ref": "#/$defs/conformanceLevel"}, "kind": {"$ref": "#/$defs/caseKind"}, "outcome": {"enum": ["passed", "failed", "skipped", "unsupported", "not_run"]}, "reason": {"type": "string"}, "finding_codes": {"type": "array", "items": {"type": "string"}}, "observed_artifact_digest": {"$ref": "#/$defs/digest"}, "result_digest": {"$ref": "#/$defs/digest"}}, "additionalProperties": false}
  }
}
