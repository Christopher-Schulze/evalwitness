# Secrets. Never commit a real key; .env.example carries the template.
.env
.env.*
!.env.example

# Local working notes. Task tracking, agent instructions and scratch documents
# are how this repository is developed, not what it publishes. The findings they
# produced live in docs/findings.md and the committed artifacts.
/docs/tasks/
/docs/tasks.md
/AGENTS.md
/CLAUDE.md
/.claude/
/handover.md
/notes/
/scratch/
/OWNER-NEXT-ACTIONS.md

# Build output
/evalwitness
/evalwitness-*
# Transitional local binaries from the pre-EvalWitness identity remain ignored.
/logprobe
/logprobe-*
*.exe
/dist/
/build/
/web/explorer/dist/
/web/explorer/node_modules/
*.tsbuildinfo

# Response cache and local run state
/.evalwitness-cache/
/.logprobe-cache/
/cache/
__pycache__/
*.pyc

# Benchmark trajectory data: 226 MB, distributed as release assets and fetched
# by eval/fetch-eval-data.sh rather than carried in git history.
/eval/trajectories/
/dist-eval-data/

# Test and coverage output
*.test
*.out
coverage.txt
/web/explorer/playwright-report/
/web/explorer/test-results/

# Atomic-publish temporaries
/eval/results/.*

# Local agent workspace
/.opencode/
/.codex/
/.cursor/
/.continue/

