# Copy to .env and fill in one key. .env is gitignored; never commit a real key.

# === Route ===
# Configure any OpenAI-compatible Chat Completions endpoint. Presets are
# optional compatibility bundles; custom values make the product portable.
EVALWITNESS_PROVIDER=your-provider       # arbitrary label for cache/audit identity
EVALWITNESS_WIRE_FORMAT=openai
EVALWITNESS_BASE_URL=https://your-provider.example/v1
EVALWITNESS_MODEL=your-model
EVALWITNESS_API_KEY=                     # or <UPPER_PROVIDER>_API_KEY

# Optional: select a registered preset instead of the custom route above.
# EVALWITNESS_PRESET=your-preset

# === Verifier behavior ===
# EVALWITNESS_THINKING_MODE=disabled       # default/enabled/disabled. Thinking modes usually
#                                       # suppress logprobs, which silently disables the verifier
# EVALWITNESS_BILLING_MODEL=pay-as-you-go  # or subscription
# EVALWITNESS_INPUT_USD_PER_M=
# EVALWITNESS_CACHED_USD_PER_M=
# EVALWITNESS_OUTPUT_USD_PER_M=

# === Selection ===
# Defaults are measured, not guessed; see the README section each one links to.
# EVALWITNESS_MAX_PAIR_CALLS=2             # a third call changed no decision on either benchmark
# EVALWITNESS_PAIR_CONFIDENCE=0.6          # the reliability curve is not monotone; treat as a
#                                       # ranking, not as a probability
# EVALWITNESS_SINGLE_ELIM=true             # tournament; false restores exhaustive all-pairs
# EVALWITNESS_SELECTION=                   # "absolute" scores each trajectory alone
# EVALWITNESS_EVIDENCE_TOKENS=32000        # 16k is cheaper and not measurably worse, nor
#                                       # measurably safe; 32k is the conservative side
# EVALWITNESS_BIAS_MITIGATION=adaptive     # "both" evaluates every pair in both orders
# EVALWITNESS_MULTI_CRITERION_BUNDLE=true
# EVALWITNESS_CRITIQUE_THEN_SCORE=true
# EVALWITNESS_DEFAULT_REPS=1
# EVALWITNESS_EXPECTED_ESCALATION_RATE=0.25
# EVALWITNESS_PAIR_CALIBRATION_SIGMA=0.05
# EVALWITNESS_INCONSISTENCY_POLICY=flag-only
# EVALWITNESS_SPRT=false

# === Runtime ===
# EVALWITNESS_CACHE_DIR=~/.cache/evalwitness
# EVALWITNESS_LEGACY_CACHE_DIR=~/.cache/logprobe # optional read-only cache import
# EVALWITNESS_MAX_WORKERS=8
# EVALWITNESS_MAX_RETRIES=5                # every retry consumes the hard eval budget
# EVALWITNESS_TIMEOUT_SEC=120
# EVALWITNESS_LOG_LEVEL=info
# EVALWITNESS_STREAM=true
# EVALWITNESS_MAX_TOKENS=0                 # 0 = the 4096 reference cap
# EVALWITNESS_TEMPERATURE=1.0              # 0 is remapped to 1.0: at 0 some endpoints return an
#                                       # argmax sentinel that reads as maximum confidence
# EVALWITNESS_SEED=
# EVALWITNESS_CONTEXT_LIMIT=1000000
# EVALWITNESS_OFFLINE=false
# EVALWITNESS_MAX_COST_USD_PER_CALL=
# EVALWITNESS_AUDIT_LOG=
# EVALWITNESS_REDACT_PATTERNS=             # JSON file with extra redaction rules
# EVALWITNESS_JUDGE_MODE=false             # raw-text extraction, no logprob requests
# EVALWITNESS_ALLOW_JUDGE_MODE=false       # doctor accepts logprob-less routes as judge mode
# EVALWITNESS_REPLAY_FROM=
# EVALWITNESS_REPLAY_TO=
# EVALWITNESS_RUN_BUDGET_STATE=            # restart-safe eval budget JSON

# === Config file ===
# EVALWITNESS_CONFIG_FILE=~/.config/evalwitness/config.toml
