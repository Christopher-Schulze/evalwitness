        "equal",
        "indeterminate",
        "left",
        "not_applicable",
        "right"
      ]
    },
    {
      "id": "information_sufficiency",
      "question": "Is the visible material sufficient to make the required comparisons?",
      "allowed_ratings": [
        "indeterminate",
        "insufficient",
        "sufficient"
      ]
    },
    {
      "id": "presentation_equivalence",
      "question": "Are the sides equivalent apart from presentation?",
