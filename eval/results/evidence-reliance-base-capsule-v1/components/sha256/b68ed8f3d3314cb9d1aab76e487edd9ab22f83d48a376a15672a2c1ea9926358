{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evalwitness.dev/protocol/1.2/schemas/score-evidence.schema.json",
  "title": "EvalWitness ScoreEvidence",
  "type": "object",
  "required": ["schema_version", "policy_version", "tag", "extraction_mode", "alignment_status", "aligned_position", "requested_top_k", "returned_top_k", "visible_probability_mass_decimal", "valid_score_mass_decimal", "unobserved_probability_mass_decimal", "score_support", "visible_alternatives", "conditional_expected_score_decimal", "conditional_variance_decimal", "extracted", "degradations", "requested_model", "route_limitations", "request_fingerprint", "response_evidence_digest"],
  "properties": {
    "schema_version": {"const": "evalwitness.protocol.score-evidence.v1"},
    "policy_version": {"type": "string", "minLength": 1},
    "tag": {"type": "string", "minLength": 1},
    "extraction_mode": {"enum": ["verifier", "judge"]},
    "alignment_status": {"enum": ["exact", "ambiguous", "missing", "truncated", "invalid"]},
    "aligned_position": {"type": "object", "required": ["token_index", "token_byte", "stream_byte", "raw_byte"], "properties": {"token_index": {"type": "integer", "minimum": 0}, "token_byte": {"type": "integer", "minimum": 0}, "stream_byte": {"type": "integer", "minimum": 0}, "raw_byte": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "requested_top_k": {"type": "integer", "minimum": 1},
    "returned_top_k": {"type": "integer", "minimum": 1},
    "visible_probability_mass_decimal": {"$ref": "shared.schema.json#/$defs/decimal"},
    "valid_score_mass_decimal": {"$ref": "shared.schema.json#/$defs/decimal"},
    "unobserved_probability_mass_decimal": {"$ref": "shared.schema.json#/$defs/decimal"},
    "score_support": {"type": "array", "minItems": 1, "items": {"$ref": "shared.schema.json#/$defs/scoreSupport"}},
    "visible_alternatives": {"type": "array", "minItems": 1, "items": {"$ref": "shared.schema.json#/$defs/visibleAlternative"}},
    "conditional_expected_score_decimal": {"$ref": "shared.schema.json#/$defs/decimal"},
    "conditional_variance_decimal": {"$ref": "shared.schema.json#/$defs/decimal"},
    "extracted": {"type": "boolean"},
    "degradations": {"type": "array", "items": {"type": "object", "required": ["code"], "properties": {"code": {"type": "string", "minLength": 1}, "detail": {"type": "string"}}, "additionalProperties": false}},
    "requested_model": {"type": "string", "minLength": 1},
    "served_model": {"type": "string"},
    "route_limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "request_fingerprint": {"$ref": "shared.schema.json#/$defs/digest"},
    "response_evidence_digest": {"$ref": "shared.schema.json#/$defs/digest"},
    "capability_attestation_digest": {"$ref": "shared.schema.json#/$defs/digest"}
  },
  "allOf": [
    {"if": {"properties": {"extracted": {"const": true}}}, "then": {"properties": {"alignment_status": {"const": "exact"}}}}
  ],
  "additionalProperties": false
}
